#!/usr/bin/env ruby
# frozen_string_literal: true

# realpath, not __dir__: the CLI runs through a ~/.local/bin/forge symlink.
ROOT = File.expand_path("..", File.dirname(File.realpath(__FILE__)))
$LOAD_PATH.unshift File.join(ROOT, "lib")

# Load the repo .env (a symlink to the secrets store) without overriding
# anything already exported. The store's FORGE_API_KEY is used as-is.
env_file = File.join(ROOT, ".env")
if File.file?(env_file)
  File.foreach(env_file) do |line|
    next if line.strip.empty? || line.lstrip.start_with?("#")

    key, value = line.chomp.split("=", 2)
    next unless value

    ENV[key.sub(/\Aexport\s+/, "").strip] ||= value.strip.delete_prefix('"').delete_suffix('"')
  end
end

require "forge_cli/browser"
require "forge_cli/client"
require "forge_cli/context"
require "forge_cli/error"
require "forge_cli/formatter"
require "forge_cli/version"

COMMANDS = %w[
  me orgs
  servers server
  sites site deploys deploy-log deploy-status deploy-script env domains certs logs
  dbs db-users daemons daemon-log jobs job-output firewall events event-output server-log
  deploy env-set deploy-script-set
  firewall-create firewall-delete service reboot
  daemon-create daemon-delete daemon-restart job-create job-delete
  db-create db-delete db-user-create db-user-update db-user-delete
  site-create site-update site-delete domain-create domain-delete cert-issue cert-delete
].freeze

# Commands that change Forge. Each returns an Affected (nil on a dry run or
# no-op), and bin/forge opens that page in the browser so no write is silent.
# See lib/forge_cli/browser.rb.
WRITE_COMMANDS = %w[
  deploy env-set deploy-script-set
  firewall-create firewall-delete service reboot
  daemon-create daemon-delete daemon-restart job-create job-delete
  db-create db-delete db-user-create db-user-update db-user-delete
  site-create site-update site-delete domain-create domain-delete cert-issue cert-delete
].freeze

def usage(status = 1)
  puts <<~USAGE
    Usage: forge [-j|--json] [--org SLUG] <command> [args] [options]

    Global flags:
      -j, --json     JSON envelope output: {"ok": true, "command": ..., "data": ...}
      --org SLUG     Organization (default: FORGE_ORG, else the token's only org)
      --version      Print the version
      -h, --help     This help

    Account:
      me                              The user that owns FORGE_API_KEY
      orgs                            Organizations the token can see

    Servers:
      servers                         Every server in the org
      server [SERVER]                 One server's details (name or id; -S also works)

    Sites:
      sites [-S SERVER]               Every site in the org (or on one server)
      site SITE                       One site's details
      deploys SITE [-n N]             Recent deployments, newest first (default 10, max 100)
      deploy-log SITE [DEPLOYMENT_ID] A deployment's output (default: the latest)
      deploy-status SITE              Running deployment status, or idle
      deploy-script SITE              The deploy script (auto_source goes to stderr)
      env SITE [--reveal]             The .env with values masked; --reveal prints raw values
      domains SITE                    The site's domains
      certs SITE                      The site's SSL certificates
      logs SITE [--type T] [--tail N] Site log: application (default), nginx-access, nginx-error;
                                      last N lines (default 200, 0 = all)

    Server resources (all take -S SERVER):
      dbs                             Database schemas
      db-users                        Database users
      daemons                         Background processes
      daemon-log DAEMON_ID            A background process's log
      jobs [--site SITE]              Scheduled jobs on the server (or on one site)
      job-output JOB [--site SITE]    A scheduled job's output (JOB is a name or id)
      firewall                        Firewall rules
      events [-n N]                   Recent events, newest first (org-wide unless -S; default 20)
      event-output EVENT_ID           An event's output
      server-log KEY [--tail N]       A server log, e.g. nginx-access, nginx-error, php-8.4,
                                      redis-server, database-mysql (default 200 lines, 0 = all)

    Writes (every write takes -d/--dry-run: print the request, send nothing):
      deploy SITE [-w|--wait] [--timeout SEC]
                                      Queue a deployment; --wait polls until it finishes
                                      (exit 1 on failure or after SEC, default 900)
      env-set SITE MODE [--cache] [--queues] [--reveal] [-y]
                                      Replace the .env (guarded). MODE is one of --file PATH,
                                      --stdin, or one or more --set KEY=VALUE / --unset KEY.
                                      Prints changed key names only; the dry-run body is
                                      masked unless --reveal
      deploy-script-set SITE (--file PATH | --stdin) [--[no-]auto-source] [-y]
                                      Replace the deploy script (guarded)

    Server writes (all take -S SERVER):
      firewall-create --name NAME [--port PORT] [--ip ADDR] [--type allow|deny]
                                      Add a firewall rule (type default allow)
      firewall-delete RULE [-y]       Remove a firewall rule by name or id (guarded)
      service SERVICE ACTION [--php-version phpNN] [-y]
                                      Run a service action. SERVICE: nginx, mysql, postgres,
                                      redis, supervisor, php. ACTION: restart (sent as reboot)
                                      or reboot for all; stop for nginx, mysql, postgres
                                      (guarded); reload for php. php's version defaults to
                                      the server's php_version
      reboot [--power-cycle] [-y]     Reboot (or power-cycle) the server (guarded)
      daemon-create --name NAME --command CMD [--user forge|root] [--directory DIR]
                    [--processes N] [--site SITE] [--startsecs N] [--stopwaitsecs N]
                    [--stopsignal SIG]
                                      Add a background process (user forge, 1 process)
      daemon-delete DAEMON_ID [-y]    Remove a background process (guarded)
      daemon-restart DAEMON_ID        Restart a background process
      job-create --command CMD --frequency F [--cron EXPR] [--name NAME] [--user USER]
                 [--heartbeat] [--site SITE]
                                      Schedule a job. F: minutely, hourly, nightly, weekly,
                                      monthly, reboot, custom; --cron is required with custom
                                      and only allowed with it. User default forge
      job-delete JOB [--site SITE] [-y]
                                      Remove a scheduled job by name or id (guarded)

    Database writes (all take -S SERVER):
      db-create NAME [--user USER] [--password-stdin]
                                      Create a database; --user also creates a user for it
      db-delete DB [-y]               Drop a database by name or id (guarded)
      db-user-create NAME [--databases a,b] [--read-only] [--password-stdin]
                                      Create a database user with access to those databases
      db-user-update USER [--databases a,b] [--password-stdin]
                                      Change a user's password and/or grants; --databases
                                      REPLACES the grants with exactly that list
      db-user-delete USER [-y]        Remove a database user by name or id (guarded)
      Passwords are never arguments: pipe one line to --password-stdin, or run on
      a terminal to be prompted without echo. Dry runs print the password masked.

    Site writes:
      site-create DOMAIN [-S SERVER] [--type T] [--php phpNN] [--web-dir DIR]
                  [--repo OWNER/NAME [--branch B] [--provider github|gitlab|bitbucket]]
                  [--isolated --isolated-user U] [--zero-downtime] [--wildcard]
                  [--www from-www|to-www|none]
                                      Create a site on DOMAIN (type default laravel; web dir
                                      default /public for laravel, symfony, statamic)
      site-update SITE [--php phpNN] [--type T] [--directory DIR] [--root-path P]
                  [--branch B] [--[no-]push-to-deploy] [--deployment-retention N]
                                      Change a site's settings (give at least one)
      site-delete SITE [-y]           Delete a site and its files (guarded)
      domain-create SITE DOMAIN [--www from-www|to-www|none] [--wildcard]
                                      Add a domain to a site (www default none)
      domain-delete SITE DOMAIN [-y]  Remove a domain by name or id (guarded)
      cert-issue SITE DOMAIN [--verification http-01|dns-01] [--key-type ecdsa|rsa]
                                      Request a Let's Encrypt certificate for a domain
                                      (defaults http-01, ecdsa)
      cert-delete SITE DOMAIN CERT_ID [-y]
                                      Remove a certificate from a domain (guarded; type
                                      the domain name)

    Guarded writes ask you to type the resource's name (the site, server, rule,
    job, database, database user, or domain name; a daemon's id) on a TTY;
    pass -y/--yes to confirm non-interactively (required with --stdin). A write
    that changes nothing prints "no change" and sends nothing.

    SERVER defaults to FORGE_SERVER, else the org's only server.
    SITE is a site name (its domain) or id; site commands find its server
    themselves, and -S only narrows the lookup.

    Environment:
      FORGE_API_KEY     API token (loaded from the repo .env symlink)
      FORGE_ORG         Default organization slug
      FORGE_SERVER      Default server name or id
      FORGE_DEBUG       Set to 1 for backtraces on errors (never prints the token)
      FORGE_NO_BROWSER  Set to 1 to stop writes opening the Forge page in a browser
      NO_COLOR          Disable color in human output

    Exit codes: 0 ok, 1 error, 2 auth, 3 not found, 4 API error.
  USAGE
  exit status
end

# Strip global flags before dispatch so per-command OptionParser never sees them.
# Arguments after a literal "--" are left alone.
def extract_globals(argv)
  cut = argv.index("--") || argv.size
  head = argv[0...cut]
  tail = argv[cut..]
  globals = { json: false, org: nil }

  rest = []
  until head.empty?
    arg = head.shift
    case arg
    when "-j", "--json" then globals[:json] = true
    when "--org"
      value = head.shift
      abort "Error: --org needs a value" if value.nil? || value.start_with?("-")
      globals[:org] = value
    when /\A--org=(.*)\z/ then globals[:org] = Regexp.last_match(1)
    else rest << arg
    end
  end
  [globals, rest + tail]
end

globals, argv = extract_globals(ARGV.dup)
ARGV.clear
cmd = argv.shift

if cmd == "--version"
  puts "forge #{ForgeCli::VERSION}"
  exit 0
end
usage if cmd.nil? || cmd == "-h" || cmd == "--help"
unless COMMANDS.include?(cmd)
  $stderr.puts "Unknown command: #{cmd}"
  usage
end

formatter = globals[:json] ? ForgeCli::JsonFormatter : ForgeCli::Formatter

def report(label, error)
  $stderr.puts "#{label}#{error.message}"
  $stderr.puts error.backtrace.first(5).join("\n") if ENV["FORGE_DEBUG"] == "1" && error.backtrace
end

begin
  require "forge_cli/commands/#{cmd.tr('-', '_')}"
  klass = ForgeCli::Commands.const_get(cmd.split(/[-_]/).map(&:capitalize).join)
  client = ForgeCli::Client.new
  ctx = ForgeCli::Context.new(client: client, formatter: formatter, org: globals[:org])
  affected = klass.run(argv, ctx: ctx, formatter: formatter)
  ForgeCli::Browser.open(affected) if WRITE_COMMANDS.include?(cmd) && affected.is_a?(ForgeCli::Affected)
rescue ForgeCli::DeployFailed => e
  # The deployment was queued; open the site so the failure is visible there.
  ForgeCli::Browser.open(e.affected) if e.affected
  report("Error: ", e)
  exit 1
rescue ForgeCli::AuthError => e
  report("Auth error: ", e)
  exit 2
rescue ForgeCli::NotFoundError => e
  report("Not found: ", e)
  exit 3
rescue ForgeCli::ApiError => e
  report("API error #{e.status}: ", e)
  $stderr.puts e.body if e.body && !e.body.to_s.strip.empty?
  exit 4
rescue ForgeCli::PartialFailure => e
  report("Partial failure: ", e)
  exit 5
rescue Errno::EPIPE
  exit 0
rescue Interrupt
  $stderr.puts
  exit 130
rescue StandardError => e
  report("Error: ", e)
  exit 1
end
